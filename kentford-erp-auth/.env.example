# Copy this file to .env on the VPS (same directory as server.js) and fill in real values.
# Until SMTP_* is set, /api/auth/forgot-password will NOT send real email — it logs the
# reset link to pending-resets.log instead and prints a loud warning to stdout (pm2 logs).

PORT=8091

# --- SMTP (choose ONE provider below) ---

# Option A: Gmail with an App Password (Google Account > Security > App passwords;
# requires 2-Step Verification enabled on the Gmail account first)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraccount@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="Kentford ERP <youraccount@gmail.com>"

# Option B: Transactional relay, e.g. Resend or SendGrid SMTP
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your-resend-api-key
# SMTP_FROM="Kentford ERP <noreply@yourdomain.com>"

# Base URL used to build password-reset links sent by email.
# Update this once a real domain + TLS are set up for the app.
PUBLIC_BASE_URL=http://69.161.221.210:8090
