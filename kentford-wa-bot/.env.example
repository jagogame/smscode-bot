OPENROUTER_KEY=
# model dipanggil lewat OpenRouter, bisa ganti ke model lain (mis. anthropic/claude-sonnet-4.5)
KENTFORD_BOT_MODEL=openai/gpt-4o-mini
# path ke db.json ERP Kentford (read-only, buat katalog produk + data customer/order/invoice)
ERP_DB_FILE=/root/kentford-erp-auth/data/db.json
# port halaman QR lokal (buka http://<vps-ip>:PORT/qr, atau tunnel SSH)
QR_PORT=8092
# jeda minimum sebelum bales (ms), biar gak keliatan terlalu robotik
REPLY_DELAY_MS=1500
